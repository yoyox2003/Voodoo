# PostgreSQL connection used by Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Clerk keys used only by the Express server. Never put CLERK_SECRET_KEY in the frontend.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_key
CLERK_SECRET_KEY=sk_test_replace_with_your_key

# Optional: Express uses 4000 when PORT is omitted.
PORT=4000
